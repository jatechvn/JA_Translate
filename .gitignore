migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Logs and temporary files
logs/
logs/*.log
assets/temp/
*.log

# Local runtime config/state - contains real API keys/secrets, never commit
config.ini
config.json
translation_cache.json
translation_history.json

# Build output / packaged releases (contains a duplicate copy of config.ini
# with the same API key baked in - must never be committed)
/dist/
dist.7z
dist.rar
dist.zip
*.7z
*.rar

# Windows Flutter ephemeral
windows/flutter/ephemeral/

# Generated Dart code
*.g.dart
*.freezed.dart

# Editor / OS
.vscode/
Thumbs.db

# Tooling
.claude/
